.DS_Store
# Локальные дополнения к правилам, живут только на машине пользователя.
*.local.md
# Бинари утилит, собираются по месту.
tools/taskctl/taskctl
tools/shipctl/shipctl
tools/agentctl/agentctl
tools/dashboard/dashboard
tools/obeycheck/obeycheck

# Каталог релизной сборки по умолчанию (devkitctl build --release): тарболлы и
# суммы собираются по месту, в git им делать нечего.
dist/
# Локальная обвязка выката, живёт только на машине.
.devkit/*.local
# Журнал запусков инструментов devkit, живёт только на машине.
.devkit/log
# Замок конвейера shipctl, лежит пустым и держится flock, а не содержимым.
.devkit/ship.lock
# Полные выводы команд под обёрткой cmdout (DK-264): файлы пишет frame.Capture,
# агенту виден путь в выжимке, в коммит им дороги нет.
.devkit/cmdout/
# Входы разговоров сессий (DK-345): реплики дашборда ждут свою сессию в дереве
# работы, разговором они остаются и в коммит им дороги нет. Прежний каталог
# рядом до конца выпуска DK-440: подхват дочитывает лежащее в нём.
.devkit/chat/
.devkit/mail/
# Кеш python: юниты уведомителя грузят hooks/notify.py как модуль.
__pycache__/

# Рабочее состояние цикла цели: журнал витков, отметки доставки и замки, живут только на машине.
.devkit/goal-*
