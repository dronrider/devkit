#!/bin/sh
# Четыре рубежа на коммите. Два по добавленным строкам staged-диффа: запрещённые
# символы везде, чувствительное в коммитимых файлах вне служебных каталогов.
# Проверяются только добавленные строки: совпадения в чужом существующем
# тексте не трогаем. Третий по составу коммита: правка кода без единого теста.
# Четвёртый снова по добавленным строкам, это проза, сбившаяся на агентский
# шаблон.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -z "$DEVKIT_NO_TESTS" ]; then
    miss=$(git diff --cached --name-only --diff-filter=ACMR |
        python3 "$here/check-tests.py" --stdin)
    status=$?
    if [ $status -eq 1 ]; then
        printf '%s\n' "$miss" >&2
        exit 1
    fi
    [ $status -ne 0 ] && exit $status
fi

added=$(git diff --cached -U0 --diff-filter=ACMR |
    awk '/^\+\+\+ b\//{file=substr($0,7)}
         /^@@/{split($3,a,","); line=substr(a[1],2)+0; next}
         /^\+/ && !/^\+\+\+/{printf "%s:%d:%s\n", file, line, substr($0,2); line++}')
[ -z "$added" ] && exit 0

bad=$(printf '%s\n' "$added" | python3 "$here/check-symbols.py" --stdin)
status=$?
if [ $status -eq 1 ]; then
    echo "запрещённые символы в добавленных строках (RULES.md, «Код и тексты» п. 1):" >&2
    printf '%s\n' "$bad" >&2
    echo "если это чужой код или тестовые данные: git commit --no-verify" >&2
    exit 1
fi
[ $status -ne 0 ] && exit $status

sens=$(printf '%s\n' "$added" | python3 "$here/check-sensitive.py" --diff)
status=$?
if [ $status -eq 1 ]; then
    echo "чувствительное в коммите (RULES.board.md, «Трекинг задач» п. 8):" >&2
    printf '%s\n' "$sens" >&2
    echo "вместо адресов и доступов роль машины, конкретика в local-docs; осознанно: git commit --no-verify" >&2
    exit 1
fi
[ $status -ne 0 ] && exit $status

# Четвёртый рубеж, сторож прозы: пороги и режим лежат в kit/prose.toml. Выход 1
# это блокировка, вывод при выходе 0 это предупреждение, и коммит от него не
# отбивается: в режиме warn текст должен доехать, а числа человек прочтёт.
prose=$(printf '%s\n' "$added" | python3 "$here/check-prose.py" --diff)
status=$?
if [ $status -eq 1 ]; then
    echo "проза в коммите сбилась на агентский шаблон (kit/prose.toml):" >&2
    printf '%s\n' "$prose" >&2
    echo "переписать по подсказкам либо осознанно: git commit --no-verify" >&2
    exit 1
fi
[ -n "$prose" ] && printf '%s\n' "$prose" >&2
exit $status
